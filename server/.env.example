NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
# Transactions require MongoDB Atlas or a local replica set.
MONGO_URI=mongodb://127.0.0.1:27017/rangvanat?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional until image uploads/email delivery are configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
STORE_EMAIL=
# Used only by npm run admin:create; no default admin is seeded.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Rangvanaat Admin
