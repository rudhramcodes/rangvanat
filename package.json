{
  "name": "rangvanat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173 --strictPort",
    "build": "vite build",
    "lint": "eslint src server/src server/scripts server/test scripts",
    "preview": "vite preview",
    "dev:storefront": "npm --prefix storefront run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:legacy": "vite",
    "build:legacy": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm --prefix server test",
    "start": "vite --host --port 5173 --strictPort",
    "lint:legacy": "eslint src",
    "dev:full": "node scripts/dev.mjs",
    "test:unit": "node --import tsx --test tests/*.test.js tests/*.test.jsx",
    "test:browser:archived": "npm --prefix storefront exec playwright -- test --config storefront/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/react": "^6.18.1",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.2.0"
  }
}
